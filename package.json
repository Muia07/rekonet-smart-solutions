  "description": "Rekonet Inv Systems website — offline-first POS, inventory and business software for Kenya",
  "main": "index.html",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "prestart": "npm run build",
    "start": "node scripts/dev-server.js --port 3000 --host 0.0.0.0",
    "build": "node scripts/build-static.js",
    "build:dev": "npm run build",
    "deploy": "npm run build && echo 'Ready for deployment'",
    "test": "echo 'No tests specified'",
    "lint": "echo 'No linter configured'",
    "optimize": "node scripts/optimize.js",
    "analyze": "echo 'Run Lighthouse for performance analysis'",
    "predev": "node scripts/generate-seo-pages.js",
    "prebuild": "node scripts/generate-seo-pages.js",
    "content:refresh": "python3 scripts/update-bundled-content.py && node scripts/generate-seo-pages.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Muia07/rekonet-smart-solutions.git"
  },
  "keywords": [
    "pos-system",
    "inventory-management",
    "business-software",
    "kenya",
    "africa",
    "e-commerce",
    "website-development"
  ],
